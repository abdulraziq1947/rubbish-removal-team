---
import { locations } from '../data/locations';
import { SITE } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-stripe" aria-hidden="true"></div>
  <div class="container footer-grid">
    <div class="footer-brand-block">
      <img src="/logo.png" alt="" class="footer-logo" width="320" height="56" />
      <p class="footer-lede">
        Rubbish removal, house clearance and junk collection across the West Midlands, with licensed
        recycling-first disposal.
      </p>
    </div>
    <div>
      <h2 class="footer-heading">Rubbish Removal Areas</h2>
      <p class="footer-links-intro">
        <a href="/locations">View all {locations.length} locations</a>
      </p>
      <ul class="footer-links">
        {locations.map((hub) => (
          <li>
            <a href={`/${hub.slug}`}>
              <span>Rubbish Removal</span>
              {hub.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {year} {SITE.name}</p>
    <p>
      House clearance · Junk removal · Garden waste · Commercial clearance ·{' '}
      <a href="/sitemap.xml">Sitemap</a>
    </p>
  </div>
</footer>
