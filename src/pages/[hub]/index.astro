---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import ServicesList from '../../components/ServicesList.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import FaqList from '../../components/FaqList.astro';
import { locations, getHub, imageForIndex } from '../../data/locations';
import { SITE } from '../../data/site';
import { buildHubGraph } from '../../lib/schema';
import { hubFaqs, hubKeywords } from '../../data/seo';
import { directionsLink, placeEmbed } from '../../data/maps';

export function getStaticPaths() {
  return locations.map((hub) => ({
    params: { hub: hub.slug },
  }));
}

const { hub: hubSlug } = Astro.params;
const hub = getHub(hubSlug!);

if (!hub) {
  return Astro.redirect('/');
}

const nearby = hub.subAreas.map((s) => s.name).join(', ');
const faqs = hubFaqs(hub.name, hub.phoneDisplay, nearby);
const image = imageForIndex(locations.findIndex((l) => l.slug === hub.slug));
const schema = buildHubGraph(hub, faqs);
const title = `Rubbish Removal ${hub.name} | House Clearance & Junk Removal`;
const description = `Rubbish removal in ${hub.name}. House clearance, junk removal, garden waste and bulky collections. Call ${hub.phoneDisplay}. Covering ${nearby}.`;
---

<Layout title={title} description={description} schema={schema} keywords={hubKeywords(hub.name)}>
  <section class="hero hero--page">
    <img class="hero__image" src={image.url} alt={image.alt} width="1600" height="900" loading="eager" />
    <div class="hero__overlay"></div>
    <div class="hero__grain" aria-hidden="true"></div>
    <div class="container hero__page-copy">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: hub.name },
        ]}
      />
      <p class="eyebrow">House clearance & junk removal</p>
      <h1>Rubbish Removal {hub.name}</h1>
      <p class="hero__lead">
        House clearance, junk removal and waste collection in {hub.name}, covering {nearby}. Call{' '}
        {hub.phoneDisplay} for same-day rubbish removal where diaries allow.
      </p>
    </div>
  </section>

  <section class="section section--overlap">
    <div class="container split">
      <div class="copy-stack">
        <p class="eyebrow">House clearance {hub.name}</p>
        <h2>House Clearance in {hub.name}</h2>
        <p>
          Need rubbish removed in {hub.name}? {SITE.name} provides house clearance, junk removal and
          waste collection for homes, landlords and businesses across {hub.region}. Furniture,
          appliances, garden waste, renovation debris and general clutter — loaded and taken through
          licensed channels with recycling first.
        </p>
        <p>
          Rubbish removal in {hub.name} covers the town plus {nearby}. One room or a full property:
          no skip hire and no tip run. Call {hub.phoneDisplay} to book collection.
        </p>
        {hub.streetAddress && (
          <p class="address-line">
            Address: {hub.streetAddress}
            {hub.postalCode ? `, ${hub.name} ${hub.postalCode}` : `, ${hub.name}`}
          </p>
        )}
      </div>
      <ContactBlock hub={hub} />
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Map</p>
        <h2>Rubbish Removal {hub.name} Location</h2>
        <p>
          Find rubbish removal in {hub.name} on the map.{' '}
          <a href={hub.gmb} target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
          {' '}or{' '}
          <a href={directionsLink(hub)} target="_blank" rel="noopener noreferrer">get driving directions</a>.
        </p>
      </div>
      <MapEmbed
        src={placeEmbed(hub)}
        title={`Rubbish Removal Team ${hub.name} on Google Maps`}
        label={`Show ${hub.name} on Google Maps`}
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2>Rubbish Removal Services in {hub.name}</h2>
      </div>
      <ServicesList placeName={hub.name} />
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Nearby areas</p>
        <h2>Rubbish Removal Near {hub.name}</h2>
        <p>
          House clearance and junk removal pages for neighbourhoods around {hub.name}.
        </p>
      </div>
      <div class="pin-grid">
        {
          hub.subAreas.map((sub) => (
            <a class="pin-card" href={`/${hub.slug}/${sub.slug}`}>
              <span class="pin-card__dot" aria-hidden="true"></span>
              <strong>Rubbish Removal {sub.name}</strong>
              <span>Junk removal & house clearance near {hub.name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2>Rubbish Removal {hub.name} FAQs</h2>
      </div>
      <FaqList items={faqs} />
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <div class="section-head section-head--light">
        <p class="eyebrow">Why book locally</p>
        <h2>Why Choose Rubbish Removal in {hub.name}</h2>
      </div>
      <ul class="reason-grid">
        <li>
          <h3>Local {hub.name} number</h3>
          <p>Call {hub.phoneDisplay} for rubbish removal in {hub.name} — not a national call centre.</p>
        </li>
        <li>
          <h3>Same-day junk removal</h3>
          <p>House clearance and bulky collections in {hub.name} when the diary allows.</p>
        </li>
        <li>
          <h3>Full rubbish removal range</h3>
          <p>House, garden, office, bulky items and renovation waste collection in {hub.name}.</p>
        </li>
        <li>
          <h3>Licensed waste collection</h3>
          <p>Recycling-first sorting before residual waste leaves {hub.name}.</p>
        </li>
      </ul>
    </div>
  </section>
</Layout>
