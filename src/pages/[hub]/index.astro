---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import ServicesList from '../../components/ServicesList.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import FaqList from '../../components/FaqList.astro';
import { locations, getHub, imageForIndex } from '../../data/locations';
import { SITE } from '../../data/site';
import { buildHubGraph } from '../../lib/schema';
import { hubFaqs, hubKeywords } from '../../data/seo';
import { directionsLink, placeEmbed } from '../../data/maps';

export function getStaticPaths() {
  return locations.map((hub) => ({
    params: { hub: hub.slug },
  }));
}

const { hub: hubSlug } = Astro.params;
const hub = getHub(hubSlug!);

if (!hub) {
  return Astro.redirect('/');
}

const nearby = hub.subAreas.map((s) => s.name).join(', ');
const faqs = hubFaqs(hub.name, hub.phoneDisplay, nearby);
const image = imageForIndex(locations.findIndex((l) => l.slug === hub.slug));
const schema = buildHubGraph(hub, faqs);
const title = `Rubbish Removal ${hub.name} | House Clearance & Junk Removal`;
const description = `Rubbish removal in ${hub.name}. Call ${hub.phoneDisplay} for house clearance, garden waste, bulky items, and junk removal. Serving ${nearby}.`;
---

<Layout title={title} description={description} schema={schema} keywords={hubKeywords(hub.name)}>
  <section class="hero hero--page">
    <img class="hero__image" src={image.url} alt={image.alt} width="1600" height="900" loading="eager" />
    <div class="hero__overlay"></div>
    <div class="hero__grain" aria-hidden="true"></div>
    <div class="container hero__page-copy">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: hub.name },
        ]}
      />
      <p class="eyebrow">Location hub · {hub.region}</p>
      <h1>Rubbish Removal {hub.name}</h1>
      <p class="hero__lead">
        Local waste clearance covering {hub.name}: {hub.catchmentNote}.
      </p>
    </div>
  </section>

  <section class="section section--overlap">
    <div class="container split">
      <div class="copy-stack">
        <p class="eyebrow">Local crew</p>
        <h2>Waste clearance in {hub.name}</h2>
        <p>
          Need rubbish removed in {hub.name}? {SITE.name} provides junk removal for homes,
          landlords, and businesses across {hub.region}. Furniture, appliances, garden waste,
          renovation debris, and general clutter — loaded and taken through licensed channels with
          recycling first.
        </p>
        <p>
          The {hub.name} team covers the town plus {nearby}. One room or a full property: no skip
          hire, no tip run. Call {hub.phoneDisplay} to book the local crew.
        </p>
        {hub.streetAddress && (
          <p class="address-line">
            Local listing: {hub.streetAddress}
            {hub.postalCode ? `, ${hub.name} ${hub.postalCode}` : `, ${hub.name}`}
          </p>
        )}
      </div>
      <ContactBlock hub={hub} />
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Find us</p>
        <h2>{hub.name} on Google Maps</h2>
        <p>
          Interactive map of Rubbish Removal Team {hub.name}.{' '}
          <a href={hub.gmb} target="_blank" rel="noopener noreferrer">Open the Google listing</a>
          {' '}or{' '}
          <a href={directionsLink(hub)} target="_blank" rel="noopener noreferrer">get driving directions</a>.
        </p>
      </div>
      <MapEmbed
        src={placeEmbed(hub)}
        title={`Rubbish Removal Team ${hub.name} on Google Maps`}
        label={`Show ${hub.name} on Google Maps`}
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2>Rubbish removal in {hub.name}</h2>
      </div>
      <ServicesList placeName={hub.name} />
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Catchment</p>
        <h2>Areas we cover near {hub.name}</h2>
        <p>
          Neighbourhood pages for junk removal and house clearance around {hub.name}.
        </p>
      </div>
      <div class="pin-grid">
        {
          hub.subAreas.map((sub) => (
            <a class="pin-card" href={`/${hub.slug}/${sub.slug}`}>
              <span class="pin-card__dot" aria-hidden="true"></span>
              <strong>Rubbish Removal {sub.name}</strong>
              <span>Junk removal & house clearance near {hub.name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2>Rubbish removal {hub.name} FAQs</h2>
      </div>
      <FaqList items={faqs} />
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <div class="section-head section-head--light">
        <p class="eyebrow">Why this hub</p>
        <h2>Why choose {SITE.name} in {hub.name}</h2>
      </div>
      <ul class="reason-grid">
        <li>
          <h3>Local phone line</h3>
          <p>Direct to the {hub.name} team — not a national call centre.</p>
        </li>
        <li>
          <h3>Google Business Profile</h3>
          <p>
            <a href={hub.gmb} target="_blank" rel="noopener noreferrer">Open the {hub.name} Maps listing</a>
          </p>
        </li>
        <li>
          <h3>Full clearance range</h3>
          <p>House, garden, office, bulky items, and renovation waste.</p>
        </li>
        <li>
          <h3>Licensed disposal</h3>
          <p>Recycling-first sorting before residual waste leaves site.</p>
        </li>
      </ul>
    </div>
  </section>
</Layout>
