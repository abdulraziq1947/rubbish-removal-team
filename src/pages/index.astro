---
import Layout from '../layouts/Layout.astro';
import { locations, imageForIndex, telHref } from '../data/locations';
import { SITE } from '../data/site';
import { buildHomeGraph } from '../lib/schema';

const hero = imageForIndex(0);
const schema = buildHomeGraph();
---

<Layout
  title={`${SITE.name} | Rubbish Removal Across the West Midlands`}
  description={SITE.description}
  schema={schema}
>
  <section class="hero">
    <img class="hero__image" src={hero.url} alt={hero.alt} width="1400" height="900" loading="eager" />
    <div class="hero__overlay"></div>
    <div class="container hero__content">
      <p class="brand-mark">{SITE.name}</p>
      <h1>Rubbish removal across the West Midlands</h1>
      <p class="hero__lead">
        Local teams for house clearance, garden waste, bulky items, and commercial junk removal —
        with responsible recycling wherever possible.
      </p>
    </div>
  </section>

  <section class="section" id="services">
    <div class="container">
      <div class="section__intro">
        <h2>What we clear</h2>
        <p>
          From a single sofa to a full property clearance, Rubbish Removal Team collects unwanted
          items and disposes of them properly so you can reclaim your space.
        </p>
      </div>
      <div class="service-grid">
        {
          SITE.services.map((service) => (
            <article class="service-item">
              <h3>{service.name}</h3>
              <p>{service.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt" id="locations">
    <div class="container">
      <div class="section__intro">
        <h2>Location hubs</h2>
        <p>
          Twelve local teams covering the West Midlands and nearby towns. Choose your area for
          local phone numbers, Google Maps listings, and nearby catchment pages.
        </p>
      </div>
      <div class="hub-grid">
        {
          locations.map((hub, i) => {
            const img = imageForIndex(i + 1);
            return (
              <article class="hub-card">
                <a href={`/${hub.slug}`} class="hub-card__link">
                  <img src={img.url} alt="" width="600" height="360" loading="lazy" />
                  <div class="hub-card__body">
                    <h3>Rubbish Removal {hub.name}</h3>
                    <p>{hub.catchmentNote}</p>
                    <span class="hub-card__phone">{hub.phoneDisplay}</span>
                  </div>
                </a>
                <div class="hub-card__actions">
                  <a href={telHref(hub.phone)}>Call</a>
                  <a href={hub.gmb} target="_blank" rel="noopener noreferrer">Maps</a>
                  <a href={`/${hub.slug}`}>Area page</a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>Responsible disposal</h2>
        <p>
          We sort loads for recycling and reuse before residual waste goes to licensed facilities.
          That means less landfill and a cleaner finish for homes and businesses across Birmingham,
          the Black Country, Coventry, and surrounding towns.
        </p>
        <p>
          Every hub page lists nearby catchment areas so you can find rubbish removal keywords for
          your exact neighbourhood — then call the local number for that team.
        </p>
      </div>
      <div>
        <img
          src={imageForIndex(2).url}
          alt={imageForIndex(2).alt}
          width="700"
          height="460"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</Layout>
