---
import Layout from '../layouts/Layout.astro';
import FaqList from '../components/FaqList.astro';
import { locations, imageForIndex, telHref } from '../data/locations';
import { SITE } from '../data/site';
import { buildHomeGraph } from '../lib/schema';
import { homeFaqs } from '../data/seo';

const hero = imageForIndex(0);
const faqs = homeFaqs();
const schema = buildHomeGraph(faqs);
const title = 'Rubbish Removal West Midlands | House Clearance & Junk Removal';
---

<Layout
  title={title}
  description={SITE.description}
  schema={schema}
  keywords={[
    'rubbish removal West Midlands',
    'house clearance Birmingham',
    'junk removal Wolverhampton',
    'waste collection Coventry',
    'garden waste removal Solihull',
    'house clearance Walsall',
  ]}
>
  <section class="hero">
    <img class="hero__image" src={hero.url} alt={hero.alt} width="1600" height="1000" loading="eager" />
    <div class="hero__overlay"></div>
    <div class="hero__grain" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">House clearance & junk collection</p>
        <h1>Rubbish Removal in the <span>West Midlands</span></h1>
        <p class="hero__lead">
          House clearance, junk removal, garden waste and bulky item collection across Birmingham,
          Wolverhampton, Coventry, Solihull, Walsall, Dudley and nearby towns.
        </p>
        <div class="hero__actions">
          <a class="btn btn--hivis" href="#locations">Find rubbish removal near you</a>
          <a class="btn btn--ghost" href="#how">How rubbish removal works</a>
        </div>
      </div>
      <ul class="hero__stats">
        <li>
          <strong>Local</strong>
          <span>Rubbish removal across Birmingham and the West Midlands</span>
        </li>
        <li>
          <strong>Same day</strong>
          <span>House clearance and junk removal when diaries allow</span>
        </li>
        <li>
          <strong>Licensed</strong>
          <span>Recycling-first waste collection through licensed sites</span>
        </li>
      </ul>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {
        [...locations, ...locations].map((hub) => (
          <span>Rubbish Removal {hub.name}</span>
        ))
      }
    </div>
  </div>

  <section class="section" id="services">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What we collect</p>
        <h2>House Clearance, Junk Removal and Waste Collection</h2>
        <p>
          Rubbish Removal Team collects household junk, garden waste, bulky furniture and commercial
          waste. No skip on the drive and no tip run — we load it and dispose of it through licensed
          channels.
        </p>
      </div>
      <div class="bento">
        {
          SITE.services.map((service, i) => (
            <article class:list={['bento-card', i === 0 && 'bento-card--wide']}>
              <span class="bento-card__index">{String(i + 1).padStart(2, '0')}</span>
              <h3>{service.name}</h3>
              <p>{service.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--ink" id="how">
    <div class="container">
      <div class="section-head section-head--light">
        <p class="eyebrow">Book a collection</p>
        <h2>How Rubbish Removal Works</h2>
      </div>
      <ol class="steps">
        <li>
          <span>01</span>
          <h3>Book your rubbish collection</h3>
          <p>Call with your town, waste type and access. We quote before we load.</p>
        </li>
        <li>
          <span>02</span>
          <h3>We collect your waste</h3>
          <p>Furniture, garden waste, renovation rubble and loft clutter — we do the heavy lifting.</p>
        </li>
        <li>
          <span>03</span>
          <h3>Licensed recycling and disposal</h3>
          <p>Loads are sorted for recycling and reuse before residual waste goes to licensed facilities.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" id="locations">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">West Midlands coverage</p>
        <h2>Rubbish Removal Across the West Midlands</h2>
        <p>
          Choose your town for local rubbish removal, house clearance and junk collection in
          Birmingham, Wolverhampton, Walsall, Dudley, West Bromwich, Sutton Coldfield, Solihull,
          Coventry, Nuneaton, Redditch, Halesowen and Lichfield.
        </p>
      </div>
      <div class="hub-grid">
        {
          locations.map((hub, i) => {
            const img = imageForIndex(i);
            return (
              <article class="hub-card">
                <a href={`/${hub.slug}`} class="hub-card__media">
                  <img src={img.url} alt="" width="640" height="400" loading="lazy" />
                  <span class="hub-card__tag">{String(i + 1).padStart(2, '0')}</span>
                </a>
                <div class="hub-card__body">
                  <h3>
                    <a href={`/${hub.slug}`}>Rubbish Removal {hub.name}</a>
                  </h3>
                  <p>{hub.catchmentNote}</p>
                  <p class="hub-card__phone">{hub.phoneDisplay}</p>
                  <div class="hub-card__actions">
                    <a href={telHref(hub.phone)}>Call</a>
                    <a href={hub.gmb} target="_blank" rel="noopener noreferrer">Maps</a>
                    <a href={`/${hub.slug}`}>Area page</a>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container split split--offset">
      <div class="copy-stack">
        <p class="eyebrow">Licensed waste collection</p>
        <h2>Licensed Rubbish Removal and Recycling</h2>
        <p>
          Rubbish Removal Team sorts loads for recycling and reuse before anything reaches residual
          waste. Homes and businesses in Birmingham, the Black Country, Coventry and nearby towns
          get licensed waste collection without hiring a skip.
        </p>
        <p>
          Looking for house clearance or junk removal in a specific neighbourhood? Open your town
          page for local coverage and the number for that area.
        </p>
      </div>
      <figure class="photo-frame">
        <img
          src={imageForIndex(2).url}
          alt={imageForIndex(2).alt}
          width="800"
          height="560"
          loading="lazy"
        />
        <figcaption>Recycling-first rubbish removal across the West Midlands</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2>Rubbish Removal West Midlands FAQs</h2>
      </div>
      <FaqList items={faqs} />
    </div>
  </section>
</Layout>
